  "about": {
    "title": "About Me",
    "paragraphs": [
      [
        { "type": "text", "text": "Hello! My name is " },
        { "type": "highlight", "text": "TJ Klint" },
        { "type": "text", "text": ", well, technically it's " },
        { "type": "italic", "text": "Timothy" },
        { "type": "text", "text": " (our little secret). I'm a passionate developer currently working as a " },
        { "type": "highlight", "text": "Software Engineer at " },
        { "type": "link", "text": "Planned", "href": "https://planned.com", "external": true },
        { "type": "text", "text": ", and previously worked at " },
        { "type": "link", "text": "Botpress", "href": "https://botpress.com", "external": true },
        { "type": "text", "text": " and completed internships at " },
        { "type": "link", "text": "CSE", "href": "https://www.cse-cst.gc.ca/", "external": true },
        { "type": "text", "text": " and " },
        { "type": "link", "text": "Bell", "href": "https://www.bell.ca/", "external": true },
        { "type": "text", "text": "." }
      ],
      [
        { "type": "text", "text": "I thrive in fast-paced environments where I can quickly adapt and deliver quality solutions. Beyond work, I'm passionate about hackathons and tech conferences, this led me to serve as " },
        { "type": "link", "text": "Co-Chair for CUSEC 2025", "href": "https://2025.cusec.net", "external": true },
        { "type": "text", "text": "." }
      ],
      [
        { "type": "text", "text": "I love sharing knowledge with the tech community through speaking engagements. " },
        { "type": "link", "text": "Check out my talks and speaking experience", "href": "#speaking", "external": false },
        { "type": "text", "text": "." }
      ],
      [
        { "type": "text", "text": "Outside of tech, you'll typically find me playing hockey, golfing, listening/discovering some live music, using the oxford comma, and travelling!" }
      ],
      [
        { "type": "text", "text": "You can also catch my blogs over on " },
        { "type": "link", "text": "Medium", "href": "https://medium.com/@tjklint", "external": true },
        { "type": "text", "text": " or " },
        { "type": "link", "text": "Dev.to", "href": "https://dev.to/tjklint", "external": true },
        { "type": "text", "text": ", and if you want to keep up to date with my work you should definitely connect with me over on " },
        { "type": "link", "text": "LinkedIn", "href": "https://linkedin.com/in/timothy-klint", "external": true },
        { "type": "text", "text": " and " },
        { "type": "link", "text": "GitHub", "href": "https://github.com/tjklint", "external": true },
        { "type": "text", "text": "." }
      ]
    ],
    "photoAlt": "TJ Klint"
